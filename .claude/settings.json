{
  "permissions": {
    "allow": [
      "Bash(python3 sync.py push:*)",
      "Bash(python3 sync.py pull:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git checkout --orphan:*)",
      "Bash(git commit --amend:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pip install -q pymupdf requests >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
